{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--isolated",
        "--allowed-origins",
        "http://localhost:3000;http://127.0.0.1:3000;http://localhost:8765;http://127.0.0.1:8765",
        "--output-dir",
        "/private/tmp/showcrafter-browser-claude"
      ]
    },
    "supabase-local": {
      "type": "http",
      "url": "http://127.0.0.1:55421/mcp?read_only=true&features=database"
    }
  }
}
