# Supabase — get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only service role key — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional shared server cache for dynamic show reads (real Upstash REST URL + token only).
# Leave both unset to use per-process memory cache only — no placeholders.
# UPSTASH_REDIS_REST_URL=https://xxxx.region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=****
