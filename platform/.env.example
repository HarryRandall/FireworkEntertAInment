# Supabase: get these from Supabase Dashboard > Connect > API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred current public key name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy/public-key aliases supported by the app.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional server-only public-key fallback.
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_ANON_KEY=your-anon-key
# Server-only service role key: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hosted Python song analyser (Modal). The Next.js server POSTs a Supabase
# signed URL to ANALYSER_URL with `Authorization: Bearer <ANALYSER_SHARED_SECRET>`.
# Deploy with `modal deploy platform/analyser/modal_app.py` and copy the printed URL here.
# The same secret must be stored as the Modal Secret `showcrafter` (key: ANALYSER_SHARED_SECRET).
ANALYSER_URL=
ANALYSER_SHARED_SECRET=
# Required for scheduled analyser warm-up calls in deployed environments.
CRON_SECRET=

# OpenRouter: optional for the slower LLM cue-assignment path and import worker.
# The default fast local planner does not need OpenRouter.
OPENROUTER_API_KEY=
# Optional model override when the LLM cue-assignment path is deliberately enabled,
# defaults to openai/gpt-4.1-mini.
# OPENROUTER_CUE_MODEL=openai/gpt-4.1-mini
# Optional OpenRouter ranking headers.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=ShowCrafter

# Optional shared server cache for dynamic show reads (real Upstash REST URL + token only).
# Leave both unset to use per-process memory cache only, no placeholders.
# UPSTASH_REDIS_REST_URL=https://xxxx.region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=****
