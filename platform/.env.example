# Supabase — get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional shared server cache for dynamic show reads.
# Without this, the app falls back to per-process memory cache only.
UPSTASH_REDIS_REST_URL=https://your-cache.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
