# Supabase: get these from Supabase Dashboard > Connect > API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred current public key name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy/public-key aliases supported by the app.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional server-only public-key fallback.
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_ANON_KEY=your-anon-key
# Server-only service role key: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trusted public origin used for server-generated authentication redirects.
# Set this to the production app origin in deployed environments. The same
# origin must be configured as Supabase's Site URL or an allowed redirect URL.
APP_ORIGIN=https://your-showcrafter-domain.example

# Server-only HMAC secret for the short-lived password-recovery proof cookie.
# Generate with `openssl rand -base64 48`; use a different value per environment.
PASSWORD_RECOVERY_SIGNING_SECRET=

# Hosted Python song analyser (Modal). The Next.js server POSTs a Supabase
# signed URL to ANALYSER_URL with `Authorization: Bearer <ANALYSER_SHARED_SECRET>`.
# Deploy with `modal deploy platform/analyser/modal_app.py` and copy the printed URL here.
# The same secret must be stored as the Modal Secret `showcrafter` (key: ANALYSER_SHARED_SECRET).
ANALYSER_URL=
ANALYSER_SHARED_SECRET=
# Required for scheduled analyser warm-up calls in deployed environments.
CRON_SECRET=

# Firework video reconstruction worker (Modal). The 32-byte-or-longer secret
# authorises run dispatch. Engine-validation capabilities use a domain-separated
# HMAC key derived from it, never the raw dispatch key directly.
FIREWORK_IMPORT_URL=
FIREWORK_IMPORT_SHARED_SECRET=
# Exact deployed ShowCrafter harness used by the Modal worker. Production must
# use HTTPS and the path must be exactly /internal/import-render.
FIREWORK_IMPORT_RENDER_URL=https://your-showcrafter-domain.example/internal/import-render
# Bounded worker controls. Review capture deliberately reserves renderer-tail
# slots below the harness's 48-frame PNG limit.
IMPORT_ENGINE_RENDER_TIMEOUT_SECONDS=300
IMPORT_ENGINE_SCORE_FRAMES=36
IMPORT_ENGINE_REVIEW_FRAMES=40
IMPORT_REVIEW_ENCODE_TIMEOUT_SECONDS=90
IMPORT_RUN_DEADLINE_SECONDS=3000

# OpenRouter: optional for the slower LLM cue-assignment path and import worker.
# The default fast local planner does not need OpenRouter.
OPENROUTER_API_KEY=
# Optional model override when the LLM cue-assignment path is deliberately enabled,
# defaults to openai/gpt-4.1-mini.
# OPENROUTER_CUE_MODEL=openai/gpt-4.1-mini
# Optional OpenRouter ranking headers.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=ShowCrafter

# Shared cache for dynamic reads. A real Upstash instance is required in
# production when password recovery is enabled so verification can be limited
# across every server process. Development falls back to per-process memory.
# UPSTASH_REDIS_REST_URL=https://xxxx.region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=****
