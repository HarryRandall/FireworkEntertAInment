{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{js,mjs,ts}",
        "tests/browser/**/*.ts",
        "services/video-importer/tests/generate-fixtures.mjs"
      ]
    },
    "apps/web": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css", "shadcn"]
    },
    "packages/*": {
      "entry": ["tests/**/*.mjs", "src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/fireworks": {
      "entry": ["tests/**/*.{mjs,ts}", "scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
    }
  },
  "ignoreIssues": {
    "apps/web/hooks/use-mobile.ts": ["files"],
    "apps/web/lib/database.types.ts": ["files", "exports", "types"],
    "apps/web/hooks/use-prefers-reduced-motion.ts": ["files"],
    "apps/web/lib/supabase/client.ts": ["files"],
    "apps/web/lib/supabase/errors.ts": ["files"],
    "apps/web/lib/supabase/fetch.ts": ["files"],
    "apps/web/lib/supabase/public-server.ts": ["files"],
    "apps/web/lib/supabase/server-client.ts": ["files"],
    "apps/web/lib/supabase/server.ts": ["files"],
    "apps/web/lib/supabase/service-role.ts": ["files"],
    "apps/web/lib/utils.ts": ["files", "exports"],
    "apps/web/lib/supabase/env.ts": ["exports"],
    "apps/web/ui/theme/ThemePreferenceSync.tsx": ["files"],
    "apps/web/lib/documents/*.generated.ts": ["exports", "types"]
  },
  "ignoreBinaries": ["ffmpeg"]
}
