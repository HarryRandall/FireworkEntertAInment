{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,ts}", "services/firework-import-worker/tests/*.mjs"]
    },
    "apps/web": {
      "entry": ["tests/**/*.mjs", "scripts/**/*.mjs"],
      "project": ["**/*.{ts,tsx,css}"],
      "ignore": ["ui/primitives/**", "lib/database.types.ts"],
      "ignoreDependencies": ["server-only"]
    },
    "packages/*": {
      "entry": ["tests/**/*.mjs", "src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/renderer": {
      "entry": ["scripts/**/*.mjs", "tests/**/*.{mjs,ts}"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
    }
  },
  "ignoreBinaries": ["ffmpeg"],
  "ignoreIssues": {
    "apps/web/lib/admin/editor-snapshots.ts": ["exports"],
    "apps/web/lib/admin/prompts.server.ts": ["exports"],
    "apps/web/lib/admin/roles.server.ts": ["exports"],
    "apps/web/lib/ai-credits.server.ts": ["exports", "types"],
    "apps/web/lib/cue-generation/schemas.ts": ["exports"],
    "apps/web/lib/cue-overlap.server.ts": ["exports"],
    "apps/web/lib/firework-preview-image.ts": ["exports", "types"],
    "apps/web/ui/shows/ShowSummaryCards.tsx": ["exports"],
    "apps/web/lib/admin/multishot-constraints.ts": ["duplicates"],
    "apps/web/lib/firework-import/jobs.ts": ["exports"]
  }
}
