{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,ts}"]
    },
    "apps/web": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["ui/primitives/**"],
      "ignoreDependencies": [
        "class-variance-authority",
        "clsx",
        "cmdk",
        "lucide-react",
        "radix-ui",
        "recharts",
        "sonner",
        "tailwind-merge",
        "tailwindcss",
        "tw-animate-css",
        "shadcn"
      ]
    },
    "packages/*": {
      "entry": ["tests/**/*.mjs", "src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreUnresolved": ["../../apps/web/lib/firework-import/reconstruction.ts"],
  "ignoreIssues": {
    "apps/web/hooks/use-mobile.ts": ["files"],
    "apps/web/hooks/use-prefers-reduced-motion.ts": ["files"],
    "apps/web/lib/supabase/client.ts": ["files"],
    "apps/web/lib/supabase/errors.ts": ["files"],
    "apps/web/lib/supabase/fetch.ts": ["files"],
    "apps/web/lib/supabase/public-server.ts": ["files"],
    "apps/web/lib/supabase/server-client.ts": ["files"],
    "apps/web/lib/supabase/server.ts": ["files"],
    "apps/web/lib/supabase/service-role.ts": ["files"],
    "apps/web/lib/utils.ts": ["files"],
    "apps/web/lib/supabase/env.ts": ["exports"],
    "apps/web/ui/theme/ThemePreferenceSync.tsx": ["files"]
  }
}
